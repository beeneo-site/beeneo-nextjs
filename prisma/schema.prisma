generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          String    @default("user")
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  taxId           String?  @unique
  address         String?
  city            String?
  gibIntegrator   String?
  gibCredentials  String?
  webhookRegistry Json?
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
  glAccounts      GLAccount[]
  glPostings      GLPosting[]
  invoices        Invoice[]
  ettnRecords     ETTNRecord[]
  bankStatements  BankStatement[]
  bankTransactions BankTransaction[]
  reconciliationMatches ReconciliationMatch[]
  employees       Employee[]
  payslips        Payslip[]
  timeEntries     TimeEntry[]
  projects        Project[]
  ecos            ECO[]
  bomItems        BOMItem[]
  stockItems      StockItem[]
  auditTrails     AuditTrail[]
  dossierRequests DossierRequest[]
  communityPosts  CommunityPost[]
  memberships     Membership[]
  exceptionLogs   ExceptionLog[]
  maskLogs        MaskLog[]
}

model GLAccount {
  id          String      @id @default(cuid())
  code        String
  name        String
  nameEn      String?
  type        String      @default("EXPENSE")
  parentCode  String?
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  postings    GLPosting[]
  createdAt   DateTime    @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model GLPosting {
  id          String    @id @default(cuid())
  date        DateTime
  accountId   String
  account     GLAccount @relation(fields: [accountId], references: [id])
  debit       Decimal   @default(0) @db.Decimal(15,2)
  credit      Decimal   @default(0) @db.Decimal(15,2)
  description String?
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([tenantId, date])
  @@index([accountId])
  @@index([invoiceId])
}

model Invoice {
  id              String      @id @default(cuid())
  invoiceNumber   String
  ettnUuid        String?     @unique
  type            String      @default("PURCHASE")
  vendorName      String?
  vendorTaxId     String?
  issueDate       DateTime
  dueDate         DateTime?
  subtotal        Decimal     @db.Decimal(15,2)
  vatAmount       Decimal     @default(0) @db.Decimal(15,2)
  totalAmount     Decimal     @db.Decimal(15,2)
  currency        String      @default("TRY")
  status          String      @default("PENDING")
  ocrConfidence   Float?      @default(0)
  rawText         String?
  sourceChannel   String?     @default("GMAIL")
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  postings        GLPosting[]
  ettnRecord      ETTNRecord?
  reconciliationMatches ReconciliationMatch[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, issueDate])
}

model ETTNRecord {
  id            String   @id @default(cuid())
  invoiceId     String   @unique
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  ettnUuid      String   @unique
  checksum      String?
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  verifyResult  String?  @default("PENDING")
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

model BankStatement {
  id            String            @id @default(cuid())
  bankName      String
  accountNumber String?
  statementDate DateTime
  fileName      String?
  importedAt    DateTime          @default(now())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  transactions  BankTransaction[]

  @@index([tenantId])
}

model BankTransaction {
  id            String            @id @default(cuid())
  statementId   String
  statement     BankStatement     @relation(fields: [statementId], references: [id])
  date          DateTime
  description   String
  amount        Decimal           @db.Decimal(15,2)
  direction     String            @default("DEBIT")
  balance       Decimal?          @db.Decimal(15,2)
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  reconciliationMatches ReconciliationMatch[]
  createdAt     DateTime          @default(now())

  @@index([tenantId, date])
  @@index([statementId])
}

model ReconciliationMatch {
  id              String          @id @default(cuid())
  invoiceId       String
  invoice         Invoice         @relation(fields: [invoiceId], references: [id])
  transactionId   String
  transaction     BankTransaction @relation(fields: [transactionId], references: [id])
  matchScore      Float
  matchStatus     String          @default("PROPOSED")
  settledAt       DateTime?
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  createdAt       DateTime        @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@index([transactionId])
}

model Employee {
  id              String      @id @default(cuid())
  employeeNo      String
  firstName       String
  lastName        String
  email           String?
  position        String?
  department      String?
  startDate       DateTime
  endDate         DateTime?
  grossSalary     Decimal     @db.Decimal(15,2)
  netSalary       Decimal?    @db.Decimal(15,2)
  sgkNo           String?
  tgbExempt       Boolean     @default(false)
  law4691Exempt   Boolean     @default(false)
  law5746Exempt   Boolean     @default(false)
  trainings       Json?
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  payslips        Payslip[]
  timeEntries     TimeEntry[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
}

model Payslip {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  period          String
  grossAmount     Decimal   @db.Decimal(15,2)
  incomeTax       Decimal   @default(0) @db.Decimal(15,2)
  sgkEmployee     Decimal   @default(0) @db.Decimal(15,2)
  sgkEmployer     Decimal   @default(0) @db.Decimal(15,2)
  stampTax        Decimal   @default(0) @db.Decimal(15,2)
  tgbExemption    Decimal   @default(0) @db.Decimal(15,2)
  netAmount       Decimal   @db.Decimal(15,2)
  status          String    @default("DRAFT")
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  createdAt       DateTime  @default(now())

  @@unique([employeeId, period])
  @@index([tenantId, period])
  @@index([employeeId])
}

model TimeEntry {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  date        DateTime
  hours       Float
  description String?
  category    String?   @default("RD")
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([tenantId, date])
  @@index([employeeId])
  @@index([projectId])
}

model Project {
  id            String      @id @default(cuid())
  code          String
  name          String
  description   String?
  client        String?
  status        String      @default("ACTIVE")
  startDate     DateTime?
  endDate       DateTime?
  budget        Decimal?    @db.Decimal(15,2)
  isoStandards  String[]    @default([])
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  timeEntries   TimeEntry[]
  ecos          ECO[]
  auditTrails   AuditTrail[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ECO {
  id            String    @id @default(cuid())
  ecoNumber     String
  title         String
  description   String?
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  status        String    @default("DRAFT")
  priority      String    @default("MEDIUM")
  requestedBy   String?
  approvedBy    String?
  impactLevel   String?   @default("LOW")
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, ecoNumber])
  @@index([tenantId, status])
  @@index([projectId])
}

model BOMItem {
  id            String    @id @default(cuid())
  partNumber    String
  name          String
  description   String?
  category      String?   @default("COMPONENT")
  quantity      Float     @default(1)
  unit          String    @default("PCS")
  unitCost      Decimal?  @db.Decimal(15,2)
  supplier      String?
  parentPartNo  String?
  projectCode   String?
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, partNumber])
  @@index([tenantId])
}

model StockItem {
  id            String    @id @default(cuid())
  partNumber    String
  name          String
  barcode       String?   @unique
  location      String?   @default("MAIN")
  quantityOnHand Float    @default(0)
  reorderLevel  Float     @default(0)
  unit          String    @default("PCS")
  lastScanned   DateTime?
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, partNumber])
  @@index([tenantId])
  @@index([barcode])
}

model AuditTrail {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String?
  action      String
  details     String?
  userId      String?
  isoRef      String?
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([projectId])
}

model DossierRequest {
  id            String    @id @default(cuid())
  type          String    @default("TUBITAK_1501")
  title         String?
  status        String    @default("DRAFT")
  documents     Json?
  generatedAt   DateTime?
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

model CommunityPost {
  id          String    @id @default(cuid())
  title       String
  content     String?
  category    String    @default("BLOG")
  author      String?
  tags        String[]  @default([])
  published   Boolean   @default(false)
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([tenantId])
}

model Membership {
  id          String    @id @default(cuid())
  email       String
  tier        String    @default("FREE")
  status      String    @default("ACTIVE")
  expiresAt   DateTime?
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([tenantId])
}

model ExceptionLog {
  id            String    @id @default(cuid())
  type          String    @default("ACCOUNTING")
  severity      String    @default("YELLOW")
  entityType    String?
  entityId      String?
  description   String
  confidence    Float?    @default(0)
  reviewedBy    String?
  reviewedAt    DateTime?
  status        String    @default("PENDING")
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([tenantId, status])
  @@index([severity])
}

model MaskLog {
  id          String    @id @default(cuid())
  fieldType   String
  originalHash String?
  maskedValue String?
  context     String?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
}
